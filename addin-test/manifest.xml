<?xml version="1.0" encoding="UTF-8"?>
<!-- Hello-world test add-in for PowerPoint. Checks whether user add-ins can be
     uploaded on a given computer, and which PowerPoint APIs it supports. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>b68d0d16-aaa5-4ff2-916e-30608e6a94b4</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Do Now Quiz Builder</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="Do Now add-in test" />
  <Description DefaultValue="Test add-in: inserts a text box and a slide to check add-ins work here." />
  <IconUrl DefaultValue="https://notsofastmatey.github.io/do-now-quiz-builder/addin-test/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://notsofastmatey.github.io/do-now-quiz-builder/addin-test/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/Notsofastmatey/do-now-quiz-builder" />
  <AppDomains>
    <AppDomain>https://notsofastmatey.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://notsofastmatey.github.io/do-now-quiz-builder/addin-test/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
